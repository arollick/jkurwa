{
  "name": "jkurwa",
  "version": "1.22.7",
  "description": "Ukrainian national EC cryptography (DSTU-4145) implementaion",
  "type": "module",
  "main": "dist/index.cjs",
  "browser": {
    "./lib/rand.js": "./lib/rand.browser.js"
  },
  "scripts": {
    "prepare": "npm run build",
    "test": "vitest run",
    "cover": "npm run test -- --coverage",
    "build": "npm run build:cjs && npm run build:esm",
    "build:cjs": "esbuild ./lib/index.js --bundle --platform=node --format=cjs --target=node14.18 --outfile=./dist/index.cjs --external:asn1.js --external:js-lzma --external:jksreader --external:gost89 --external:bn.js --external:buffer",
    "build:esm": "esbuild ./lib/index.js --bundle --platform=node --format=esm --target=node14.18 --outfile=./dist/index.mjs --external:asn1.js --external:js-lzma --external:jksreader --external:gost89 --external:bn.js --external:buffer"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:dstucrypt/jkurwa"
  },
  "keywords": [
    "ecc",
    "cryptography",
    "dstu4145",
    "ukraine"
  ],
  "author": "Ilya Petrov",
  "license": "BSD",
  "bugs": {
    "url": "https://github.com/dstucrypt/jkurwa/issues"
  },
  "homepage": "https://github.com/dstucrypt/jkurwa/",
  "devDependencies": {
    "codecov": "^3.8.1",
    "eslint": "^5.9.0",
    "eslint-config-airbnb": "^17.1.0",
    "eslint-config-prettier": "^4.2.0",
    "eslint-plugin-import": "^2.14.0",
    "gost89": "^0.1.11",
    "prettier": "^1.17.0",
    "esbuild": "^0.25.5",
    "vite": "^6.3.5",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "asn1.js": "muromec/asn1.js",
    "bn.js": ">= 0.14",
    "buffer": ">= 3.0",
    "jksreader": "^1.0.0",
    "js-lzma": "0.x"
  },
  "eslintConfig": {
    "extends": [
      "airbnb",
      "prettier"
    ]
  },
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs",
      "default": "./dist/index.cjs"
    }
  }
}
